{
  "name": "acme-cloud-support",
  "version": "1",
  "description": "Hand-written golden set for the Acme Cloud demo corpus: real support questions paired with the document that should answer them. A few queries carry graded relevance so NDCG is exercised meaningfully.",
  "queries": [
    {
      "query_id": "q-invoice-download",
      "query": "where do I download a copy of last month's invoice",
      "expected_documents": [
        { "document_id": "doc-billing-001", "relevance": 3 }
      ],
      "note": "Direct lookup; should be an easy win for any healthy index."
    },
    {
      "query_id": "q-change-card",
      "query": "how do I update the credit card we pay with",
      "expected_documents": [
        { "document_id": "doc-billing-002", "relevance": 3 }
      ]
    },
    {
      "query_id": "q-refund-downgrade",
      "query": "do we get money back if we downgrade our plan mid month",
      "expected_documents": [
        { "document_id": "doc-billing-003", "relevance": 3 },
        { "document_id": "doc-billing-001", "relevance": 1 }
      ],
      "note": "Graded: the refund policy is the answer, the invoice page is weakly related."
    },
    {
      "query_id": "q-overage",
      "query": "what happens when we go over the included api call allowance",
