# Copy to .env to override the docker compose defaults.
#
#   cp .env.example .env && docker compose up --build

# Port the dashboard is published on.
DRIFT_PORT=8080

# Log verbosity for the API container.
DRIFT_LOG_LEVEL=INFO

# Chroma collection the evaluations score against.
DRIFT_CHROMA_COLLECTION=drift_demo

# Cutoffs each run is evaluated at, and the one drift detection tests.
DRIFT_EVAL_K_VALUES=1,3,5,10
DRIFT_EVAL_PRIMARY_K=5

# Set to false to start empty, against your own corpus and golden set,
# instead of the bundled demo data.
DRIFT_BOOTSTRAP_DEMO=true
